# Copy this file to .env and fill in real values. Never commit .env.
# Anything prefixed VITE_ is bundled into client-side JS and publicly
# visible in the browser — never put a secret key behind a VITE_ prefix.

# Base URL of the DutyLaunch API.
# Development (with the Vite proxy) you can leave this as /api.
# Production example: https://api.dutylaunch.com/api
VITE_API_URL=/api

# Absolute origin of the deployed site, used for canonical URLs and Open Graph.
VITE_SITE_URL=http://localhost:5173

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs &
# Services -> Credentials). This is a public identifier by design — safe to
# expose here. The matching client SECRET must never be placed in this
# project; it has no use on the frontend at all.
VITE_GOOGLE_CLIENT_ID=
